<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.376" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="VipCoreApi">
      <HintPath>lib\VipCoreApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Server-ready layout: build/addons/counterstrikesharp/{plugins/VIP_Bhop, gamedata} -->
  <Target Name="CopyToServerLayout" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)/build/addons/counterstrikesharp/plugins/VIP_Bhop" />
    <Copy SourceFiles="gamedata/vip_bhop.json" DestinationFolder="$(MSBuildProjectDirectory)/build/addons/counterstrikesharp/gamedata" />
  </Target>

</Project>
